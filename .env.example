# ==============================================================================
# InsightSQL Configuration (.env.example)
# Copy this file to .env and replace the values with your local settings.
# ==============================================================================

PROJECT_NAME="InsightSQL: Natural Language Data Explorer"

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Local PostgreSQL instance (default port 5432)
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/ai_analyst

# If running inside Docker Compose, use the service name 'db':
# DATABASE_URL=postgresql+psycopg://postgres:root@db:5432/ai_analyst

# Optional: Separate read-only connection pool for additional isolation
# READONLY_DATABASE_URL=postgresql+psycopg://read_only_user:password@localhost:5432/ai_analyst

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider options: "groq" (Recommended for sub-second inference) or "openai"
LLM_PROVIDER=groq

# Groq API Configuration (Get your key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Alternative: OpenAI Configuration (Uncomment if using OpenAI)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Security, Limits & Execution Guardrails
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=100           # Max file upload size in megabytes
MAX_IMPORT_ROWS=1000000     # Max rows allowed per imported dataset table
QUERY_TIMEOUT_MS=5000       # PostgreSQL statement execution timeout in milliseconds
MAX_RESULT_ROWS=500         # Hard ceiling on rows returned per query to prevent memory exhaustion

# ------------------------------------------------------------------------------
# CORS Origins
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
